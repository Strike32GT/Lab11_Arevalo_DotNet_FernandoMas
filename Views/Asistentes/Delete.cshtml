@model Asistente
@{
    ViewData["Title"] = "Eliminar asistente";
}

<h1>Eliminar asistente</h1>

<div class="alert alert-warning">
    La eliminación es lógica: el asistente dejará de mostrarse en la lista, pero no se borrará de la base de datos.
</div>

<dl class="row">
    <dt class="col-sm-3">Nombres</dt>
    <dd class="col-sm-9">@Model.Nombres</dd>

    <dt class="col-sm-3">DNI</dt>
    <dd class="col-sm-9">@Model.Dni</dd>

    <dt class="col-sm-3">Correo</dt>
    <dd class="col-sm-9">@Model.Correo</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Telefono) ? "Sin teléfono" : Model.Telefono)</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
