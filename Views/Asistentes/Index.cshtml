@model IEnumerable<Asistente>
@{
    ViewData["Title"] = "Asistentes";
}

<h1>Asistentes</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">Nuevo asistente</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Nombres</th>
            <th>DNI</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No hay asistentes activos para mostrar.</td>
            </tr>
        }
        else
        {
            foreach (var asistente in Model)
            {
                <tr>
                    <td>@asistente.Nombres</td>
                    <td>@asistente.Dni</td>
                    <td>@asistente.Correo</td>
                    <td>@asistente.Telefono</td>
                    <td>@(asistente.Activo ? "Activo" : "Inactivo")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@asistente.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@asistente.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@asistente.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
