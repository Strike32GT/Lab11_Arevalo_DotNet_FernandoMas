@model Evento
@{
    ViewData["Title"] = "Detalle del evento";
}

<h1>@Model.Titulo</h1>

<dl class="row">
    <dt class="col-sm-3">Categoría</dt>
    <dd class="col-sm-9">@Model.Categoria?.Nombre</dd>

    <dt class="col-sm-3">Fecha</dt>
    <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Lugar</dt>
    <dd class="col-sm-9">@Model.Lugar</dd>

    <dt class="col-sm-3">Modalidad</dt>
    <dd class="col-sm-9">@Model.Modalidad</dd>

    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">S/ @Model.Precio.ToString("N2")</dd>

    <dt class="col-sm-3">Aforo</dt>
    <dd class="col-sm-9">@Model.Aforo</dd>

    <dt class="col-sm-3">Inscritos confirmados</dt>
    <dd class="col-sm-9">@Model.InscritosConfirmados</dd>

    <dt class="col-sm-3">Cupos disponibles</dt>
    <dd class="col-sm-9">@Model.CuposDisponibles</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Activo" : "Inactivo")</dd>
</dl>

<h4>Asistentes confirmados</h4>

@if (!Model.Inscripciones.Any(i => i.Estado == EstadosInscripcion.Confirmada))
{
    <p class="text-muted">Aún no hay asistentes confirmados.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Asistente</th>
                <th>DNI</th>
                <th>Fecha de inscripción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inscripcion in Model.Inscripciones.Where(i => i.Estado == EstadosInscripcion.Confirmada))
            {
                <tr>
                    <td>@inscripcion.Asistente?.Nombres</td>
                    <td>@inscripcion.Asistente?.Dni</td>
                    <td>@inscripcion.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
