@model IEnumerable<Evento>
@{
    ViewData["Title"] = "Eventos";
}

<h1>Eventos</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="categoriaId">Categoría</label>
        <select id="categoriaId" name="categoriaId" class="form-select" asp-items="ViewBag.Categorias">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
    <div class="col-auto ms-auto">
        <a asp-action="Create" class="btn btn-success">Nuevo evento</a>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Título</th>
            <th>Categoría</th>
            <th>Fecha</th>
            <th>Lugar</th>
            <th>Modalidad</th>
            <th>Precio</th>
            <th>Aforo</th>
            <th>Inscritos</th>
            <th>Cupos</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="10" class="text-center text-muted">No hay eventos activos para mostrar.</td>
            </tr>
        }
        else
        {
            foreach (var evento in Model)
            {
                <tr>
                    <td>@evento.Titulo</td>
                    <td>@evento.Categoria?.Nombre</td>
                    <td>@evento.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@evento.Lugar</td>
                    <td>@evento.Modalidad</td>
                    <td>S/ @evento.Precio.ToString("N2")</td>
                    <td>@evento.Aforo</td>
                    <td>@evento.InscritosConfirmados</td>
                    <td>@evento.CuposDisponibles</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@evento.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@evento.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@evento.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
