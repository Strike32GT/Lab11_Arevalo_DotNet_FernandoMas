@model Inscripcion
@{
    ViewData["Title"] = "Nueva inscripción";
}

<h1>Nueva inscripción</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="EventoId" class="form-label"></label>
                <select asp-for="EventoId" class="form-select" asp-items="ViewBag.Eventos">
                    <option value="">-- Seleccione un evento --</option>
                </select>
                <span asp-validation-for="EventoId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AsistenteId" class="form-label"></label>
                <select asp-for="AsistenteId" class="form-select" asp-items="ViewBag.Asistentes">
                    <option value="">-- Seleccione un asistente --</option>
                </select>
                <span asp-validation-for="AsistenteId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
