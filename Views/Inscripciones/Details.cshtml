@model Inscripcion
@{
    ViewData["Title"] = "Detalle de la inscripción";
}

<h1>Detalle de la inscripción</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<dl class="row">
    <dt class="col-sm-3">Evento</dt>
    <dd class="col-sm-9">@Model.Evento?.Titulo</dd>

    <dt class="col-sm-3">Fecha del evento</dt>
    <dd class="col-sm-9">@(Model.Evento?.Fecha.ToString("dd/MM/yyyy"))</dd>

    <dt class="col-sm-3">Lugar</dt>
    <dd class="col-sm-9">@Model.Evento?.Lugar</dd>

    <dt class="col-sm-3">Modalidad</dt>
    <dd class="col-sm-9">@Model.Evento?.Modalidad</dd>

    <dt class="col-sm-3">Asistente</dt>
    <dd class="col-sm-9">@Model.Asistente?.Nombres</dd>

    <dt class="col-sm-3">DNI</dt>
    <dd class="col-sm-9">@Model.Asistente?.Dni</dd>

    <dt class="col-sm-3">Correo</dt>
    <dd class="col-sm-9">@Model.Asistente?.Correo</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@(Model.Asistente?.Telefono ?? "Sin teléfono")</dd>

    <dt class="col-sm-3">Fecha de inscripción</dt>
    <dd class="col-sm-9">@Model.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    @if (Model.Estado == EstadosInscripcion.Confirmada)
    {
        <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-warning">Cancelar inscripción</button>
        </form>
    }
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Eliminar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
