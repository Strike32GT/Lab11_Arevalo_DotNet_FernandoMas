@model Inscripcion
@{
    ViewData["Title"] = "Eliminar inscripción";
}

<h1>Eliminar inscripción</h1>

<div class="alert alert-danger">
    Esta acción eliminará la inscripción definitivamente de la base de datos. Si solo deseas anularla, usa la opción Cancelar.
</div>

<dl class="row">
    <dt class="col-sm-3">Evento</dt>
    <dd class="col-sm-9">@Model.Evento?.Titulo</dd>

    <dt class="col-sm-3">Asistente</dt>
    <dd class="col-sm-9">@Model.Asistente?.Nombres</dd>

    <dt class="col-sm-3">Fecha de inscripción</dt>
    <dd class="col-sm-9">@Model.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
